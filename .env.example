# HackerHouse Goa 2026 - Environment Configuration

# Portrait Verification Mode
# "local" - Uses in-browser MediaPipe tasks-vision (Default, Accurate)
# "mock"  - Auto-passes all images (For UI development only)
NEXT_PUBLIC_PORTRAIT_VERIFICATION_MODE="local"

# Vercel Blob Storage Token
# Required for persisting ID Cards to production cloud storage.
# Generate this in your Vercel Project Dashboard -> Storage -> Create Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
